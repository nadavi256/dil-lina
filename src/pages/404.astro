---
import Base from '../layouts/Base.astro';
import { url } from '../lib/site';
---

<Base title="Page not found" description="That page is not on Lina." noindex>
  <article class="wrap page-hero">
    <p class="kicker">404</p>
    <h1>This page is not on the edit.</h1>
    <p class="lede">The link may be left over from an older version of the site, or simply mistyped.</p>
    <div class="hero-actions" style="margin-bottom: 3rem">
      <a class="btn btn-ink" href={url('/')}>Back to Lina</a>
      <a class="btn btn-line" href={url('/cities')}>Browse cities</a>
    </div>
  </article>
</Base>
