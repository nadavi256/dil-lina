---
interface Price {
  status: 'TODO' | 'verified';
  amount: number | null;
  currency: 'USD';
  unit: 'night';
  occupancy: string | null;
  stayDate: string | null;
  checkedOn: string | null;
  room: string | null;
  note: string;
}

interface Review {
  score: number;
  count: number;
  source: 'Booking.com';
  scale: 10;
  checkedOn: string;
}

interface Props {
  price: Price;
  review?: Review | null;
  compact?: boolean;
}

const { price, review = null, compact = false } = Astro.props;
const verified =
  price.status === 'verified' &&
  price.amount != null &&
  price.checkedOn &&
  price.stayDate &&
  price.occupancy &&
  price.room &&
  review != null;

const formatted =
  verified && price.amount != null
    ? new Intl.NumberFormat('en-US', { style: 'currency', currency: 'USD', maximumFractionDigits: 0 }).format(
        price.amount,
      )
    : null;

const reviewCount =
  review != null ? new Intl.NumberFormat('en-US').format(review.count) : null;
---

<div class="price-note">
  {
    verified && formatted && review && reviewCount ? (
      <>
        <p class="verified-price">
          <span class="from">from {formatted}</span>
          <span class="unit"> / night</span>
        </p>
        <p class="price-meta">Checked Nov 10–11, 2026 · prices change</p>
        <p class="price-meta">
          Booking.com {review.score.toFixed(1)} · {reviewCount} reviews
        </p>
        {!compact && <p class="price-meta">{price.room}, {price.occupancy}.</p>}
      </>
    ) : (
      <>
        <p class="todo-flag">TODO</p>
        <p>
          Nightly rate not checked yet. Nothing is printed here until a live price is verified.
          {!compact && ` ${price.note}`}
        </p>
      </>
    )
  }
</div>
