---
import { url } from '../lib/site';

interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <a href={url('/')}>Home</a>
  {
    items.map((item) => (
      <>
        <span aria-hidden="true">/</span>
        {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
      </>
    ))
  }
</nav>
